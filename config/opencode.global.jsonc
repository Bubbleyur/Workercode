{
  "$schema": "https://opencode.ai/config.json",
  // Big Pickle global defaults — copy to ~/.config/opencode/opencode.jsonc
  // (the bootstrap script does this automatically).
  "update": "disable",
  "formatter": true,
  "providers": {
    "9router": {
      "env": ["NINEROUTER_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.9router.com/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "oc/union-alpha": { "name": "oc/union-alpha" },
        "oc/muse-spark-1.3-contributor-free": { "name": "oc/muse-spark-1.3" },
        "oc/muse-spark-1.2-contributor-free": { "name": "oc/muse-spark-1.2" },
        "sekai/tencent/hy4-preview": { "name": "sekai/tencent/hy4-preview" },
        "sekai/cx/gpt-6-astra": { "name": "sekai/cx/gpt-6-astra" }
      }
    }
  }
}
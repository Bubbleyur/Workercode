# ---- Big Pickle environment -----------------------------------------------
# Copy to .env (the launcher does this for you via the wizard) — never commit.

# 9router gateway (many models, one key) — create one at console.9router.com
NINEROUTER_API_KEY=sk-xxxxxxxx
NINEROUTER_BASE_URL=https://api.9router.com/v1

# OpenCode Zen (OpenCode's own gateway — has a free tier, no key needed for
# the free models). Model refs look like opencode/big-pickle.
# Get a key at https://opencode.ai/zen
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional direct providers
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-xxx
# GROQ_API_KEY=gsk_xxx

# Messaging integrations (usually set by the wizard instead)
# DISCORD_BOT_TOKEN=MTEx...
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890

# Overrides (optional — settings.json normally wins)
# BIGPICKLE_PORT=4096
# BIGPICKLE_HOST=127.0.0.1
# BIGPICKLE_WORKERS=2
# BIGPICKLE_HEALTH_PORT=8099
# BIGPICKLE_TOKEN=         # the opencode server password (written automatically)